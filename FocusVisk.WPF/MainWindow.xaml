<Window x:Class="FocusVisk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FocusVisk"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="FocusVisk"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F14"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

  <Window.Resources>
    <ContextMenu x:Key="TrayMenu">
      <MenuItem Header="Abrir Focus" Click="TrayOpen_Click" FontWeight="Bold"/>
      <Separator/>
      <MenuItem Header="Iniciar Pomodoro" Click="TrayPomodoro_Click"/>
      <MenuItem Header="Nova tarefa rápida" Click="TrayNewTask_Click"/>
      <Separator/>
      <MenuItem Header="Sair" Click="TrayExit_Click"/>
    </ContextMenu>
  </Window.Resources>

  <Grid>
    <tb:TaskbarIcon x:Name="TrayIcon"
                    IconSource="pack://application:,,,/Resources/icon.ico"
                    ToolTipText="FocusVisk"
                    ContextMenu="{StaticResource TrayMenu}"
                    TrayMouseDoubleClick="TrayIcon_DoubleClick"/>

    <blazor:BlazorWebView x:Name="BlazorView"
                          HostPage="wwwroot/index.html"
                          Services="{DynamicResource services}">
      <blazor:BlazorWebView.RootComponents>
        <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:AppComponent}"/>
      </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
  </Grid>
</Window>
