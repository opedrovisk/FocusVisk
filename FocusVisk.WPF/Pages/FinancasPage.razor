@inject FinancasService FinSvc
@inject IJSRuntime JS
@implements IDisposable

<div class="page-header flex justify-between items-center">
    <div>
        <h1 class="page-title">Finanças</h1>
        <p class="page-subtitle">@_mes.ToString("MMMM yyyy", new System.Globalization.CultureInfo("pt-BR"))</p>
    </div>
    <div class="flex gap-2">
        <button class="btn btn-ghost" @onclick="() => _showGoalForm = !_showGoalForm">
            <i class="fa-solid fa-bullseye"></i> Meta
        </button>
        <button class="btn btn-ghost financa-btn-saida" @onclick='() => OpenForm("saida")'>
            <i class="fa-solid fa-minus"></i> Saída
        </button>
        <button class="btn btn-primary" @onclick='() => OpenForm("entrada")'>
            <i class="fa-solid fa-plus"></i> Entrada
        </button>
    </div>
</div>

@if (_showForm)
{
    <div class="card mb-4">
        <h3 style="font-size:15px; font-weight:600; margin-bottom:16px; color: @(_formType == "entrada" ? "var(--accent-green)" : "var(--accent-coral)")">
            <i class="fa-solid @(_formType == "entrada" ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
            @(_formType == "entrada" ? "Nova Entrada" : "Nova Saída")
        </h3>
        <div class="flex-col gap-3">
            <div class="grid-2">
                <div>
                    <label class="text-sm text-muted">Título *</label>
                    <input class="input mt-1" placeholder="ex: Salário, Aluguel..." @bind="_formTitle" />
                </div>
                <div>
                    <label class="text-sm text-muted">Valor (R$) *</label>
                    <input class="input mt-1 font-mono" type="number" min="0.01" step="0.01"
                           placeholder="0,00" @bind="_formAmount" />
                </div>
            </div>
            <div class="grid-2">
                <div>
                    <label class="text-sm text-muted">Categoria</label>
                    <select class="select mt-1" @bind="_formCategory">
                        <option value="0">Geral</option>
                        <option value="1">Alimentação</option>
                        <option value="2">Moradia</option>
                        <option value="3">Transporte</option>
                        <option value="4">Saúde</option>
                        <option value="5">Educação</option>
                        <option value="6">Lazer</option>
                        <option value="7">Salário</option>
                        <option value="8">Investimento</option>
                        <option value="9">Outros</option>
                    </select>
                </div>
                <div>
                    <label class="text-sm text-muted">Descrição (opcional)</label>
                    <input class="input mt-1" placeholder="Detalhes..." @bind="_formDescription" />
                </div>
            </div>
            <div class="flex gap-2">
                <button class="btn btn-primary" @onclick="SaveTransaction">Salvar</button>
                <button class="btn btn-ghost" @onclick="CloseForm">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (_showGoalForm)
{
    <div class="card mb-4">
        <h3 style="font-size:15px; font-weight:600; margin-bottom:16px;">
            <i class="fa-solid fa-bullseye" style="color:var(--accent-amber)"></i>
            Meta de economia — @_mes.ToString("MMMM", new System.Globalization.CultureInfo("pt-BR"))
        </h3>
        <div class="grid-2">
            <div>
                <label class="text-sm text-muted">Nome da meta</label>
                <input class="input mt-1" placeholder="ex: Economizar este mês" @bind="_goalTitle" />
            </div>
            <div>
                <label class="text-sm text-muted">Valor alvo (R$)</label>
                <input class="input mt-1 font-mono" type="number" min="1" step="1"
                       placeholder="500,00" @bind="_goalAmount" />
            </div>
        </div>
        <div class="flex gap-2 mt-4">
            <button class="btn btn-primary" @onclick="SaveGoal">Salvar meta</button>
            <button class="btn btn-ghost" @onclick="() => _showGoalForm = false">Cancelar</button>
        </div>
    </div>
}

<div class="grid-4 mb-4">
    <div class="financa-saldo-card">
        <span class="financa-saldo-label">Saldo Total</span>
        <span class="financa-saldo-value @(_saldoTotal >= 0 ? "positivo" : "negativo")">
            @FormatBrl(_saldoTotal)
        </span>
    </div>
    <div class="stat-card" style="flex-direction:row; align-items:center; gap:14px;">
        <div class="stat-card-icon" style="color:var(--accent-green); font-size:20px; flex-shrink:0;">
            <i class="fa-solid fa-arrow-trend-up"></i>
        </div>
        <div>
            <div class="stat-card-label">Entradas no mês</div>
            <div class="stat-card-value" style="color:var(--accent-green)">@FormatBrl(_totalEntradas)</div>
        </div>
    </div>
    <div class="stat-card" style="flex-direction:row; align-items:center; gap:14px;">
        <div class="stat-card-icon" style="color:var(--accent-coral); font-size:20px; flex-shrink:0;">
            <i class="fa-solid fa-arrow-trend-down"></i>
        </div>
        <div>
            <div class="stat-card-label">Saídas no mês</div>
            <div class="stat-card-value" style="color:var(--accent-coral)">@FormatBrl(_totalSaidas)</div>
        </div>
    </div>
    <div class="stat-card" style="flex-direction:row; align-items:center; gap:14px;">
        <div class="stat-card-icon" style="color:var(--accent-amber); font-size:20px; flex-shrink:0;">
            <i class="fa-solid fa-wallet"></i>
        </div>
        <div>
            <div class="stat-card-label">Líquido do mês</div>
            <div class="stat-card-value @(_saldoMes >= 0 ? "" : "text-coral")">@FormatBrl(_saldoMes)</div>
        </div>
    </div>
</div>

@if (_currentGoal != null)
{
    var progresso = _currentGoal.TargetAmount > 0
        ? Math.Min(100, (double)(_saldoMes > 0 ? _saldoMes : 0) / (double)_currentGoal.TargetAmount * 100)
        : 0;
    <div class="card mb-4">
        <div class="flex justify-between items-center mb-2">
            <span style="font-size:13.5px; font-weight:600;">
                <i class="fa-solid fa-bullseye" style="color:var(--accent-amber)"></i>
                @_currentGoal.Title
            </span>
            <span class="text-sm text-muted">
                @FormatBrl(_saldoMes > 0 ? _saldoMes : 0) / @FormatBrl(_currentGoal.TargetAmount)
            </span>
        </div>
        <div class="financa-progress-track">
            <div class="financa-progress-bar" style="width:@progresso.ToString("F0")%"></div>
        </div>
        <p class="text-sm text-muted mt-2">
            @if (progresso >= 100)
            {
                <span style="color:var(--accent-green)"><i class="fa-solid fa-circle-check"></i> Meta atingida! 🎉</span>
            }
            else
            {

                <span>Faltam @FormatBrl(_currentGoal.TargetAmount - (_saldoMes > 0 ? _saldoMes : 0)) para atingir a meta</span>
            }
        </p>
    </div>
}

<div style="display:grid; grid-template-columns: 1fr 320px; gap:20px; margin-bottom:20px;">
    <div class="card">
        <p style="font-size:13px; font-weight:600; margin-bottom:12px; color:var(--text-secondary)">
            <i class="fa-solid fa-chart-line"></i> Evolução do saldo (últimos 7 dias)
        </p>
        <canvas id="financa-line-chart" height="160"></canvas>
    </div>
    <div class="card">
        <p style="font-size:13px; font-weight:600; margin-bottom:12px; color:var(--text-secondary)">
            <i class="fa-solid fa-chart-pie"></i> Gastos por categoria
        </p>
        @if (_totalSaidas == 0)
        {
            <div class="text-center text-muted" style="padding:40px 0;">
                <i class="fa-solid fa-chart-pie" style="font-size:32px; opacity:0.3;"></i>
                <p class="text-sm mt-2">Sem saídas no mês</p>
            </div>
        }
        else
        {
            <canvas id="financa-donut-chart" height="160"></canvas>
        }
    </div>
</div>

<div class="flex gap-2 mb-4 items-center">
    <span class="text-sm text-muted">Histórico:</span>
    <button class="btn @(_filtro == "all" ? "btn-primary" : "btn-ghost")" @onclick='() => SetFiltro("all")'>Tudo</button>
    <button class="btn @(_filtro == "entrada" ? "btn-primary" : "btn-ghost")" @onclick='() => SetFiltro("entrada")'>Entradas</button>
    <button class="btn @(_filtro == "saida" ? "btn-primary" : "btn-ghost")" @onclick='() => SetFiltro("saida")'>Saídas</button>
    <button class="btn @(_filtro == "mes" ? "btn-primary" : "btn-ghost")" @onclick='() => SetFiltro("mes")'>Este mês</button>
</div>

@if (_filtered.Count == 0)
{
    <div class="card text-center" style="padding:48px;">
        <p style="font-size:36px; margin-bottom:12px; opacity:0.3;"><i class="fa-solid fa-receipt"></i></p>
        <p class="text-muted">Nenhuma transação encontrada.</p>
    </div>
}
else
{
    <div class="flex-col gap-2">
        @foreach (var tx in _filtered)
        {
            var t = tx;
            var isEntrada = t.Type == TransactionType.Entrada;
            <div class="financa-tx-item @(isEntrada ? "entrada" : "saida")">
                <div class="financa-tx-icon @(isEntrada ? "entrada" : "saida")">
                    <i class="fa-solid @(isEntrada ? "fa-arrow-up" : "fa-arrow-down")"></i>
                </div>
                <div style="flex:1; min-width:0;">
                    <div style="font-size:14px; font-weight:600;">@t.Title</div>
                    <div class="flex gap-2 items-center mt-1">
                        <span class="badge @GetCategoryBadge(t.Category)">@GetCategoryLabel(t.Category)</span>
                        @if (!string.IsNullOrEmpty(t.Description))
                        {
                            <span class="text-sm text-muted truncate">@t.Description</span>
                        }
                    </div>
                </div>
                <div style="text-align:right;">
                    <div class="financa-tx-amount @(isEntrada ? "entrada" : "saida")">
                        @(isEntrada ? "+" : "-")@FormatBrl(t.Amount)
                    </div>
                    <div class="text-sm text-muted mt-1">@t.CreatedAt.ToString("dd/MM HH:mm")</div>
                </div>
                <button class="btn btn-icon btn-danger" @onclick="() => DeleteTransaction(t.Id)" title="Excluir">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>
        }
    </div>
}

<button class="financa-calc-fab" @onclick="() => _showCalc = !_showCalc" title="Calculadora">
    <i class="fa-solid fa-calculator"></i>
</button>

@if (_showCalc)
{
    <div class="financa-calc-panel">
        <div class="financa-calc-display">
            <div class="financa-calc-expr">@(_calcExpr == "" ? "0" : _calcExpr)</div>
            <div class="financa-calc-result font-mono">@_calcResult</div>
        </div>
        <div class="financa-calc-grid">
            @foreach (var btn in _calcButtons)
            {
                var b = btn;
                <button class="financa-calc-btn @GetCalcBtnClass(b)" @onclick="() => CalcPress(b)">@b</button>
            }
        </div>
    </div>
}

@code {
    private List<FinancaTransaction> _all = new();
    private List<FinancaTransaction> _filtered = new();
    private string _filtro = "mes";
    private DateTime _mes = DateTime.Today;

    private decimal _saldoTotal = 0;
    private decimal _totalEntradas = 0;
    private decimal _totalSaidas = 0;
    private decimal _saldoMes = 0;

    private bool _showForm = false;
    private string _formType = "entrada";
    private string _formTitle = "";
    private string? _formDescription;
    private decimal _formAmount = 0;
    private int _formCategory = 0;

    private bool _showGoalForm = false;
    private SavingGoal? _currentGoal;
    private string _goalTitle = "Economizar este mês";
    private decimal _goalAmount = 0;

    private bool _showCalc = false;
    private string _calcExpr = "";
    private string _calcResult = "";
    private readonly string[] _calcButtons = new[]
    {
        "C", "±", "%", "÷",
        "7", "8", "9", "×",
        "4", "5", "6", "-",
        "1", "2", "3", "+",
        "0", ".", "⌫", "="
    };

    protected override async Task OnInitializedAsync()
    {
        FinSvc.OnChanged += HandleChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await RenderChartsAsync();
    }

    private async void HandleChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
        await RenderChartsAsync();
    }

    private async Task LoadAsync()
    {
        _all = await FinSvc.GetAllAsync();

        var mesAtual = await FinSvc.GetByMonthAsync(_mes.Year, _mes.Month);
        _totalEntradas = mesAtual.Where(t => t.Type == TransactionType.Entrada).Sum(t => t.Amount);
        _totalSaidas = mesAtual.Where(t => t.Type == TransactionType.Saida).Sum(t => t.Amount);
        _saldoMes = _totalEntradas - _totalSaidas;
        _saldoTotal = await FinSvc.GetSaldoAsync();

        _currentGoal = await FinSvc.GetGoalAsync(_mes.Year, _mes.Month);
        if (_currentGoal != null)
        {
            _goalTitle = _currentGoal.Title;
            _goalAmount = _currentGoal.TargetAmount;
        }

        ApplyFilter();
    }

    private void SetFiltro(string f) { _filtro = f; ApplyFilter(); }

    private void ApplyFilter()
    {
        _filtered = _filtro switch
        {
            "entrada" => _all.Where(t => t.Type == TransactionType.Entrada).ToList(),
            "saida" => _all.Where(t => t.Type == TransactionType.Saida).ToList(),
            "mes" => _all.Where(t => t.CreatedAt.Year == _mes.Year && t.CreatedAt.Month == _mes.Month).ToList(),
            _ => _all.ToList()
        };
    }

    private void OpenForm(string tipo)
    {
        _formType = tipo; _formTitle = ""; _formDescription = null;
        _formAmount = 0; _formCategory = 0;
        _showForm = true; _showGoalForm = false;
    }

    private void CloseForm() { _showForm = false; }

    private async Task SaveTransaction()
    {
        if (string.IsNullOrWhiteSpace(_formTitle) || _formAmount <= 0) return;
        await FinSvc.AddAsync(new FinancaTransaction
        {
            Title = _formTitle.Trim(),
            Description = _formDescription,
            Amount = _formAmount,
            Type = _formType == "entrada" ? TransactionType.Entrada : TransactionType.Saida,
            Category = (TransactionCategory)_formCategory
        });
        CloseForm();
    }

    private async Task SaveGoal()
    {
        if (_goalAmount <= 0) return;
        await FinSvc.SaveGoalAsync(new SavingGoal
        {
            Title = string.IsNullOrWhiteSpace(_goalTitle) ? "Meta do mês" : _goalTitle,
            TargetAmount = _goalAmount,
            MonthYear = new DateTime(_mes.Year, _mes.Month, 1)
        });
        _showGoalForm = false;
    }

    private async Task DeleteTransaction(int id)
    {
        await FinSvc.DeleteAsync(id);
    }

    private async Task RenderChartsAsync()
    {
        var hoje = DateTime.Today;
        var labels = new List<string>();
        var saldos = new List<decimal>();
        decimal acumulado = _all
            .Where(t => t.CreatedAt.Date < hoje.AddDays(-6))
            .Sum(t => t.Type == TransactionType.Entrada ? t.Amount : -t.Amount);

        for (int i = 6; i >= 0; i--)
        {
            var dia = hoje.AddDays(-i);
            labels.Add(dia.ToString("dd/MM"));
            var do_dia = _all.Where(t => t.CreatedAt.Date == dia.Date);
            acumulado += do_dia.Sum(t => t.Type == TransactionType.Entrada ? t.Amount : -t.Amount);
            saldos.Add(acumulado);
        }

        var categorias = _all
            .Where(t => t.Type == TransactionType.Saida
                     && t.CreatedAt.Year == _mes.Year
                     && t.CreatedAt.Month == _mes.Month)
            .GroupBy(t => t.Category)
            .Select(g => new { label = GetCategoryLabel(g.Key), value = g.Sum(x => x.Amount) })
            .ToList();

        try
        {
            await JS.InvokeVoidAsync("focusApp.renderFinancaCharts",
                labels.ToArray(),
                saldos.Select(s => (double)s).ToArray(),
                categorias.Select(c => c.label).ToArray(),
                categorias.Select(c => (double)c.value).ToArray());
        }
        catch { }
    }

    private void CalcPress(string btn)
    {
        switch (btn)
        {
            case "C":
                _calcExpr = ""; _calcResult = ""; break;
            case "⌫":
                if (_calcExpr.Length > 0) _calcExpr = _calcExpr[..^1]; break;
            case "=":
                CalcEval(); break;
            case "±":
                if (_calcExpr.StartsWith("-")) _calcExpr = _calcExpr[1..];
                else if (_calcExpr != "") _calcExpr = "-" + _calcExpr;
                break;
            case "%":
                CalcEvalPartial();
                if (decimal.TryParse(_calcResult, out var pv))
                { _calcExpr = (pv / 100m).ToString(); _calcResult = ""; }
                break;
            default:
                var op = btn switch { "÷" => "/", "×" => "*", _ => btn };
                _calcExpr += op;
                CalcEvalPartial();
                break;
        }
    }

    private void CalcEval()
    {
        try
        {
            var expr = _calcExpr.Replace(",", ".");
            var result = EvalExpr(expr);
            _calcResult = "";
            _calcExpr = result.ToString("G");
        }
        catch { _calcResult = "Erro"; }
    }

    private void CalcEvalPartial()
    {
        try
        {
            var expr = _calcExpr.TrimEnd('+', '-', '*', '/').Replace(",", ".");
            if (string.IsNullOrEmpty(expr)) { _calcResult = ""; return; }
            var result = EvalExpr(expr);
            _calcResult = "= " + result.ToString("N2");
        }
        catch { _calcResult = ""; }
    }

    private decimal EvalExpr(string expr)
    {
        var dt = new System.Data.DataTable();
        var result = dt.Compute(expr, null);
        return Convert.ToDecimal(result);
    }

    private string GetCalcBtnClass(string b) => b switch
    {
        "=" => "equal",
        "÷" or "×" or "-" or "+" => "op",
        "C" => "clear",
        _ => ""
    };

    private string FormatBrl(decimal v) =>
        v.ToString("C", new System.Globalization.CultureInfo("pt-BR"));

    private string GetCategoryLabel(TransactionCategory c) => c switch
    {
        TransactionCategory.Alimentacao => "Alimentação",
        TransactionCategory.Moradia => "Moradia",
        TransactionCategory.Transporte => "Transporte",
        TransactionCategory.Saude => "Saúde",
        TransactionCategory.Educacao => "Educação",
        TransactionCategory.Lazer => "Lazer",
        TransactionCategory.Salario => "Salário",
        TransactionCategory.Investimento => "Investimento",
        TransactionCategory.Outros => "Outros",
        _ => "Geral"
    };

    private string GetCategoryBadge(TransactionCategory c) => c switch
    {
        TransactionCategory.Salario or
        TransactionCategory.Investimento => "badge-green",
        TransactionCategory.Alimentacao or
        TransactionCategory.Moradia => "badge-coral",
        TransactionCategory.Transporte or
        TransactionCategory.Lazer => "badge-amber",
        TransactionCategory.Saude or
        TransactionCategory.Educacao => "badge-teal",
        _ => "badge-purple"
    };

    public void Dispose() => FinSvc.OnChanged -= HandleChanged;
}