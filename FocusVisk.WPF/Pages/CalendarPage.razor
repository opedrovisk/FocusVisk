@inject CalendarService CalSvc
@inject TaskService TaskSvc
@implements IDisposable

<div class="page-header flex justify-between items-center">
    <div>
        <h1 class="page-title">Calendário</h1>
        <p class="page-subtitle">@_currentDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("pt-BR"))</p>
    </div>
    <div class="flex gap-2">
        <button class="btn btn-ghost btn-icon" @onclick="PrevMonth"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="btn btn-ghost" @onclick="GoToday">Hoje</button>
        <button class="btn btn-ghost btn-icon" @onclick="NextMonth"><i class="fa-solid fa-chevron-right"></i></button>
    </div>
</div>

<div style="display:grid; grid-template-columns: 1fr 360px; gap: 24px; align-items: start;">

    <div class="card">
        <div class="calendar-grid" style="margin-bottom:8px;">
            @foreach (var h in new[] { "Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb" })
            {
                <div class="calendar-day-header">@h</div>
            }
        </div>
        <div class="calendar-grid">
            @foreach (var day in _calendarDays)
            {
                var d = day;
                var isToday = d.Date == DateTime.Today;
                var isSelected = d.Date == _selected.Date;
                var isOther = d.Month != _currentDate.Month;
                var hasEvents = _activeDates.Contains(d.Date);

                <div class="calendar-day @(isToday ? "today" : "") @(isSelected ? "selected" : "") @(isOther ? "other-month" : "")"
                     @onclick="() => SelectDay(d)">
                    @d.Day
                    @if (hasEvents && !isSelected)
                    {
                        <div class="calendar-dot"></div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="flex-col gap-3">
        <div class="card">
            <div class="flex justify-between items-center mb-4">
                <h3 style="font-size:14px; font-weight:600;">
                    @_selected.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))
                </h3>
                <button class="btn btn-primary" style="font-size:12px; padding:6px 12px;"
                        @onclick="NewNote">
                    <i class="fa-solid fa-plus"></i> Nota
                </button>
            </div>

            @if (_showNoteForm)
            {
                <div class="flex-col gap-2 mb-4">
                    <textarea class="textarea" placeholder="Escreva sua anotação..."
                              @bind="_noteContent" style="min-height:90px;"></textarea>
                    <div class="flex gap-2">
                        <button class="btn btn-primary" style="flex:1;" @onclick="SaveNote">Salvar</button>
                        <button class="btn btn-ghost" @onclick="() => _showNoteForm = false">Cancelar</button>
                    </div>
                </div>
            }

            @if (_dayTasks.Count > 0)
            {
                <p class="text-sm text-muted" style="margin-bottom:8px; font-weight:500;">
                    <i class="fa-solid fa-list-check" style="color:var(--accent-purple); margin-right:5px;"></i>
                    Tarefas
                </p>
                @foreach (var task in _dayTasks)
                {
                    var t = task;
                    <div style="display:flex; align-items:center; gap:8px; padding:8px 10px;
                        background:var(--bg-elevated); border-radius:var(--radius-sm);
                        margin-bottom:6px; opacity:@(t.IsCompleted ? "0.55" : "1");">
                        <div class="todo-check @(t.IsCompleted ? "checked" : "")"
                             style="flex-shrink:0; cursor:pointer;"
                             @onclick="() => ToggleTask(t.Id)">
                            @if (t.IsCompleted)
                            {
                                <i class="fa-solid fa-check" style="color:#fff; font-size:10px;"></i>
                            }
                        </div>
                        <span style="flex:1; font-size:13px; @(t.IsCompleted ? "text-decoration:line-through;" : "")">
                            @t.Title
                        </span>
                        <span class="badge @GetPriorityBadge(t.Priority)" style="font-size:10px;">
                            @GetPriorityLabel(t.Priority)
                        </span>
                    </div>
                }
                @if (_dayNotes.Count > 0)
                {
                    <div style="border-top:1px solid var(--border); margin: 10px 0 12px;"></div>
                }
            }

            @if (_dayNotes.Count == 0 && _dayTasks.Count == 0 && !_showNoteForm)
            {
                <div class="text-center text-muted" style="padding: 24px 0;">
                    <p style="font-size: 24px; margin-bottom: 8px;"><i class="fa-regular fa-clipboard icon-xl"></i></p>
                    <p class="text-sm">Nenhuma anotação ou tarefa para este dia.</p>
                </div>
            }

            @foreach (var note in _dayNotes)
            {
                var n = note;
                <div style="background: var(--bg-elevated);
                    border-left: 3px solid @(n.Color ?? "var(--accent-purple)");
                    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
                    padding: 10px 14px; margin-bottom: 8px;">
                    <p style="font-size: 13.5px; white-space: pre-wrap;">@n.Content</p>
                    <div class="flex justify-between items-center mt-2">
                        <span class="text-sm text-muted">@n.CreatedAt.ToString("HH:mm")</span>
                        <button class="btn btn-danger btn-icon" style="font-size:11px; padding:3px 7px;"
                                @onclick="() => DeleteNote(n.Id)">
                            ✕
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private DateTime _selected = DateTime.Today;
    private DateTime _currentDate = DateTime.Today;

    private List<DateTime> _calendarDays = new();
    private List<CalendarNote> _dayNotes = new();
    private HashSet<DateTime> _activeDates = new();
    private List<TodoItem> _dayTasks = new();

    private bool _showNoteForm;
    private string _noteContent = "";

    protected override async Task OnInitializedAsync()
    {
        CalSvc.OnChanged += HandleChanged;
        TaskSvc.OnChanged += HandleTaskChanged;
        BuildCalendar();
        await RefreshAsync();
    }

    private async void HandleChanged()
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleTaskChanged()
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void BuildCalendar()
    {
        _calendarDays.Clear();
        var first = new DateTime(_currentDate.Year, _currentDate.Month, 1);
        var start = first.AddDays(-(int)first.DayOfWeek);
        for (int i = 0; i < 42; i++)
            _calendarDays.Add(start.AddDays(i));
    }

    private async Task RefreshAsync()
    {
        _activeDates = await CalSvc.GetActiveDatesAsync(_currentDate.Year, _currentDate.Month, TaskSvc);
        _dayNotes = await CalSvc.GetForDayAsync(_selected);
        _dayTasks = await TaskSvc.GetCalendarTasksForDayAsync(_selected);
    }

    private async Task SelectDay(DateTime day)
    {
        _selected = day;
        _showNoteForm = false;
        _dayNotes = await CalSvc.GetForDayAsync(day);
        _dayTasks = await TaskSvc.GetCalendarTasksForDayAsync(day);
    }

    private void PrevMonth()
    {
        _currentDate = _currentDate.AddMonths(-1);
        BuildCalendar();
        _ = RefreshAsync();
        StateHasChanged();
    }

    private void NextMonth()
    {
        _currentDate = _currentDate.AddMonths(1);
        BuildCalendar();
        _ = RefreshAsync();
        StateHasChanged();
    }

    private void GoToday()
    {
        _selected = DateTime.Today;
        _currentDate = DateTime.Today;
        BuildCalendar();
        _ = RefreshAsync();
        StateHasChanged();
    }

    private void NewNote() { _noteContent = ""; _showNoteForm = true; }

    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(_noteContent)) return;
        await CalSvc.SaveAsync(new CalendarNote
        {
            Date = _selected.Date,
            Content = _noteContent.Trim()
        });
        _noteContent = "";
        _showNoteForm = false;
    }

    private async Task DeleteNote(int id) => await CalSvc.DeleteAsync(id);

    private async Task ToggleTask(int id)
    {
        await TaskSvc.ToggleAsync(id);
        _dayTasks = await TaskSvc.GetCalendarTasksForDayAsync(_selected);
    }

    private string GetPriorityBadge(Priority p) => p switch
    {
        Priority.High => "badge-coral",
        Priority.Medium => "badge-amber",
        _ => "badge-teal"
    };

    private string GetPriorityLabel(Priority p) => p switch
    {
        Priority.High => "Alta",
        Priority.Medium => "Média",
        _ => "Baixa"
    };

    public void Dispose()
    {
        CalSvc.OnChanged -= HandleChanged;
        TaskSvc.OnChanged -= HandleTaskChanged;
    }
}
