@inject HabitService HabitSvc
@implements IDisposable

<div class="page-header flex justify-between items-center">
    <div>
        <h1 class="page-title">Hábitos</h1>
        <p class="page-subtitle">@_habits.Count(h => HabitSvc.IsCompletedToday(h)) de @_habits.Count concluídos hoje</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenNewHabit">
        <i class="fa-solid fa-plus"></i> Novo hábito
    </button>
</div>

@if (_editing != null)
{
    <div class="card mb-4">
        <p style="font-size:15px; font-weight:600; margin-bottom:16px;">
            @(_editing.Id == 0 ? "Novo hábito" : "Editar hábito")
        </p>

        <div class="flex gap-2 mb-3 items-center">
            <div class="habit-icon-preview" style="background:@(_editing.Color)22; color:@_editing.Color;">
                <i class="@_editing.Icon"></i>
            </div>
            <input class="input" placeholder="Nome do hábito..." @bind="_editing.Name" style="flex:1;" />
        </div>

        <p class="text-sm text-muted mb-2">Ícone</p>
        <div class="habit-icon-grid mb-3">
            @foreach (var ico in _presetIcons)
            {
                var ic = ico;
                <button class="habit-icon-btn @(_editing.Icon == ic ? "selected" : "")"
                        @onclick="() => _editing.Icon = ic">
                    <i class="@ic"></i>
                </button>
            }
        </div>

        <p class="text-sm text-muted mb-2">Cor</p>
        <div class="habit-color-grid mb-4">
            @foreach (var col in _presetColors)
            {
                var c = col;
                <button class="habit-color-btn @(_editing.Color == c ? "selected" : "")"
                        style="background:@c;"
                        @onclick="() => _editing.Color = c"></button>
            }
            <input type="color" class="habit-color-custom" @bind="_editing.Color" title="Cor personalizada" />
        </div>

        <p class="text-sm text-muted mb-2">Presets rápidos</p>
        <div class="flex gap-2 mb-4" style="flex-wrap:wrap;">
            @foreach (var preset in _presets)
            {
                var p = preset;
                <button class="btn btn-ghost" style="font-size:12px; gap:6px;"
                        @onclick="() => ApplyPreset(p)">
                    <i class="@p.Icon" style="color:@p.Color;"></i> @p.Name
                </button>
            }
        </div>

        <div class="flex gap-2">
            <button class="btn btn-primary" @onclick="SaveHabit">Salvar</button>
            <button class="btn btn-ghost" @onclick="() => _editing = null">Cancelar</button>
            @if (_editing.Id > 0)
            {
                <button class="btn btn-danger" @onclick="DeleteHabit">Excluir</button>
            }
        </div>
    </div>
}

@if (_habits.Count == 0 && _editing == null)
{
    <div class="card text-center" style="padding:64px;">
        <p style="font-size:40px; margin-bottom:12px;">🏆</p>
        <p class="text-muted">Nenhum hábito ainda. Crie o primeiro!</p>
    </div>
}
else
{
    <div class="habits-grid">
        @foreach (var habit in _habits)
        {
            var h = habit;
            var completedToday = HabitSvc.IsCompletedToday(h);
            var streak = HabitSvc.GetStreak(h);
            var last30 = HabitSvc.GetLast30DaysCount(h);
            var weekDays = _weekDays;

            <div class="habit-card @(completedToday ? "habit-done" : "")">
                <div class="flex justify-between items-center mb-3">
                    <div class="flex items-center gap-3">
                        <div class="habit-card-icon" style="background:@(h.Color)22; color:@h.Color;">
                            <i class="@h.Icon"></i>
                        </div>
                        <div>
                            <p class="habit-card-name">@h.Name</p>
                            <p class="text-sm text-muted">
                                @if (streak > 0)
                                {
                                    <span class="habit-streak"><i class="fa-solid fa-fire"></i> @streak dia@(streak == 1 ? "" : "s")</span>
                                }
                                else
                                {
                                    <span>Sem sequência</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="flex gap-1 items-center">
                        <button class="btn btn-icon btn-ghost" title="Editar"
                                @onclick="() => OpenEditHabit(h)">
                            <i class="fa-solid fa-pen" style="font-size:11px;"></i>
                        </button>
                        <button class="habit-check-btn @(completedToday ? "checked" : "")"
                                style="@(completedToday ? $"background:{h.Color}; border-color:{h.Color};" : $"border-color:{h.Color}44;")"
                                @onclick="() => ToggleToday(h.Id)">
                            @if (completedToday)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                        </button>
                    </div>
                </div>

                <div class="habit-week-row">
                    @foreach (var day in weekDays)
                    {
                        var d = day;
                        var done = HabitSvc.IsCompletedOn(h, d);
                        var isToday = d.Date == DateTime.Today;
                        <div class="habit-week-day">
                            <span class="habit-week-label @(isToday ? "today" : "")">
                                @d.ToString("ddd", new System.Globalization.CultureInfo("pt-BR")).Substring(0, 3)
                            </span>
                            <button class="habit-week-dot @(done ? "done" : "") @(isToday ? "is-today" : "")"
                                    style="@(done ? $"background:{h.Color}; border-color:{h.Color};" : $"border-color:{h.Color}44;")"
                                    @onclick="() => ToggleDay(h.Id, d)">
                            </button>
                            <span class="habit-week-num @(isToday ? "today" : "")">@d.Day</span>
                        </div>
                    }
                </div>

                <div class="habit-card-footer">
                    <button class="habit-cal-trigger" @onclick="() => OpenCalendar(h)">
                        <i class="fa-regular fa-calendar"></i> @last30/30 dias
                    </button>
                    @if (streak >= 7)
                    {
                        <span class="badge badge-amber"><i class="fa-solid fa-trophy"></i> @streak dias!</span>
                    }
                    else if (streak >= 3)
                    {
                        <span class="badge badge-teal"><i class="fa-solid fa-fire"></i> Em sequência</span>
                    }
                </div>
            </div>
        }
    </div>
}

@if (_calendarVisible && _calendarHabit != null)
{
    var ch = _calendarHabit;
    <div class="habit-cal-overlay" @onclick="CloseCalendar">
        <div class="habit-cal-modal" @onclick:stopPropagation="true">

            <div class="habit-cal-header">
                <div class="flex items-center gap-3">
                    <div class="habit-cal-icon" style="background:@(ch.Color)22; color:@ch.Color;">
                        <i class="@ch.Icon"></i>
                    </div>
                    <div>
                        <p class="habit-cal-title">@ch.Name</p>
                        <p class="text-sm text-muted">Histórico de dias concluídos</p>
                    </div>
                </div>
                <button class="btn btn-icon btn-ghost" @onclick="CloseCalendar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="habit-cal-nav">
                <button class="btn btn-icon btn-ghost" @onclick="PrevMonth">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <span class="habit-cal-month-label">
                    @_calMonth.ToString("MMMM yyyy", new System.Globalization.CultureInfo("pt-BR"))
                </span>
                <button class="btn btn-icon btn-ghost" @onclick="NextMonth"
                        disabled="@IsCurrentMonth">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <div class="habit-cal-grid">
                @foreach (var label in _weekLabels)
                {
                    <div class="habit-cal-weekday">@label</div>
                }
                @foreach (var cell in _calCells)
                {
                    var cell2 = cell;
                    @if (cell2.Empty)
                    {
                        <div class="habit-cal-cell empty"></div>
                    }
                    else
                    {
                        var done = _calLogDates.Contains(cell2.Date);
                        var isToday = cell2.Date == DateTime.Today;
                        var isFuture = cell2.Date > DateTime.Today;
                        <button class="habit-cal-cell day @(done ? "done" : "") @(isToday ? "today" : "") @(isFuture ? "future" : "")"
                                style="@(done ? $"background:{ch.Color}; border-color:{ch.Color};" : "")"
                                disabled="@isFuture"
                                @onclick="() => ToggleCalDay(cell2.Date)">
                            <span>@cell2.Date.Day</span>
                        </button>
                    }
                }
            </div>

            <div class="habit-cal-footer">
                <div class="habit-cal-stat">
                    <span class="habit-cal-stat-value" style="color:@ch.Color;">@_calDoneDays</span>
                    <span class="text-sm text-muted">dias em @_calMonth.ToString("MMM", new System.Globalization.CultureInfo("pt-BR"))</span>
                </div>
                <div class="habit-cal-stat">
                    <span class="habit-cal-stat-value" style="color:@ch.Color;">@_calTotalDays</span>
                    <span class="text-sm text-muted">dias no mês</span>
                </div>
                <div class="habit-cal-stat">
                    <span class="habit-cal-stat-value" style="color:@ch.Color;">@_calPct%</span>
                    <span class="text-sm text-muted">aproveitamento</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Habit> _habits = new();
    private Habit? _editing;
    private List<DateTime> _weekDays = new();

    private bool _calendarVisible;
    private Habit? _calendarHabit;
    private DateTime _calMonth;
    private HashSet<DateTime> _calLogDates = new();
    private List<(bool Empty, DateTime Date)> _calCells = new();
    private int _calDoneDays;
    private int _calTotalDays;
    private int _calPct;

    private bool IsCurrentMonth =>
        _calMonth.Year == DateTime.Today.Year && _calMonth.Month == DateTime.Today.Month;

    private readonly string[] _weekLabels = { "SEG", "TER", "QUA", "QUI", "SEX", "SÁB", "DOM" };

    private readonly List<string> _presetIcons = new()
    {
        "fa-solid fa-droplet", "fa-solid fa-dumbbell", "fa-solid fa-book-open",
        "fa-solid fa-brain", "fa-solid fa-person-running", "fa-solid fa-moon",
        "fa-solid fa-apple-whole", "fa-solid fa-heart-pulse", "fa-solid fa-music",
        "fa-solid fa-pen-nib", "fa-solid fa-laptop-code", "fa-solid fa-mug-hot",
        "fa-solid fa-sun", "fa-solid fa-leaf", "fa-solid fa-bicycle", "fa-solid fa-star",
    };

    private readonly List<string> _presetColors = new()
    {
        "#7C6AF7", "#4ECDC4", "#F07070", "#F6C644",
        "#5DD68E", "#E87CA0", "#60A5FA", "#FB923C",
        "#A78BFA", "#34D399",
    };

    private record PresetHabit(string Name, string Icon, string Color);

    private readonly List<PresetHabit> _presets = new()
    {
        new("Beber água",  "fa-solid fa-droplet",        "#60A5FA"),
        new("Academia",    "fa-solid fa-dumbbell",       "#F07070"),
        new("Leitura",     "fa-solid fa-book-open",      "#F6C644"),
        new("Estudos",     "fa-solid fa-brain",          "#7C6AF7"),
        new("Correr",      "fa-solid fa-person-running", "#5DD68E"),
        new("Meditação",   "fa-solid fa-leaf",           "#4ECDC4"),
        new("Dormir cedo", "fa-solid fa-moon",           "#A78BFA"),
    };

    protected override async Task OnInitializedAsync()
    {
        HabitSvc.OnChanged += HandleChanged;
        BuildWeekDays();
        await LoadAsync();
    }

    private void BuildWeekDays()
    {
        var today = DateTime.Today;
        var dow = (int)today.DayOfWeek;
        var monday = today.AddDays(-(dow == 0 ? 6 : dow - 1));
        _weekDays = Enumerable.Range(0, 7).Select(i => monday.AddDays(i)).ToList();
    }

    private async void HandleChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync() => _habits = await HabitSvc.GetActiveAsync();

    private void OpenNewHabit() => _editing = new Habit { Icon = "fa-solid fa-star", Color = "#7C6AF7" };

    private void OpenEditHabit(Habit h) => _editing = new Habit
    {
        Id = h.Id,
        Name = h.Name,
        Icon = h.Icon,
        Color = h.Color
    };

    private void ApplyPreset(PresetHabit p)
    {
        if (_editing == null) return;
        _editing.Name = p.Name;
        _editing.Icon = p.Icon;
        _editing.Color = p.Color;
    }

    private async Task SaveHabit()
    {
        if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        await HabitSvc.SaveAsync(_editing);
        _editing = null;
    }

    private async Task DeleteHabit()
    {
        if (_editing == null || _editing.Id == 0) return;
        await HabitSvc.DeleteAsync(_editing.Id);
        _editing = null;
    }

    private async Task ToggleToday(int id) => await HabitSvc.ToggleLogAsync(id, DateTime.Today);

    private async Task ToggleDay(int id, DateTime day) => await HabitSvc.ToggleLogAsync(id, day);

    private async Task OpenCalendar(Habit h)
    {
        _calendarHabit = h;
        _calMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _calendarVisible = true;
        await LoadCalendarMonthAsync();
    }

    private void CloseCalendar()
    {
        _calendarVisible = false;
        _calendarHabit = null;
    }

    private async Task LoadCalendarMonthAsync()
    {
        if (_calendarHabit == null) return;
        _calLogDates = await HabitSvc.GetLogsForMonthAsync(_calendarHabit.Id, _calMonth.Year, _calMonth.Month);
        BuildCalCells();
        CalcCalStats();
    }

    private void BuildCalCells()
    {
        _calCells = new();
        var first = new DateTime(_calMonth.Year, _calMonth.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(_calMonth.Year, _calMonth.Month);
        var dow = (int)first.DayOfWeek;
        var blanks = dow == 0 ? 6 : dow - 1;
        for (int i = 0; i < blanks; i++)
            _calCells.Add((true, default));
        for (int d = 1; d <= daysInMonth; d++)
            _calCells.Add((false, new DateTime(_calMonth.Year, _calMonth.Month, d)));
    }

    private void CalcCalStats()
    {
        var today = DateTime.Today;
        _calTotalDays = _calMonth.Month == today.Month && _calMonth.Year == today.Year
            ? today.Day
            : DateTime.DaysInMonth(_calMonth.Year, _calMonth.Month);
        _calDoneDays = _calLogDates.Count;
        _calPct = _calTotalDays > 0 ? (int)Math.Round(_calDoneDays * 100.0 / _calTotalDays) : 0;
    }

    private async Task PrevMonth()
    {
        _calMonth = _calMonth.AddMonths(-1);
        await LoadCalendarMonthAsync();
    }

    private async Task NextMonth()
    {
        if (!IsCurrentMonth)
        {
            _calMonth = _calMonth.AddMonths(1);
            await LoadCalendarMonthAsync();
        }
    }

    private async Task ToggleCalDay(DateTime date)
    {
        if (_calendarHabit == null || date > DateTime.Today) return;
        await HabitSvc.ToggleLogAsync(_calendarHabit.Id, date);
        _calLogDates = await HabitSvc.GetLogsForMonthAsync(_calendarHabit.Id, _calMonth.Year, _calMonth.Month);
        CalcCalStats();
    }

    public void Dispose() => HabitSvc.OnChanged -= HandleChanged;
}
